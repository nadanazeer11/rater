# Database (Supabase Postgres — Session pooler URL for migrations + runtime)
DATABASE_URL=

# Redis (Upstash) — for BullMQ
REDIS_URL=

# Supabase Auth + project
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWT_SECRET=

# Postmark (worker sends review-request emails)
POSTMARK_SERVER_TOKEN=
POSTMARK_ACCOUNT_TOKEN=
POSTMARK_FROM_EMAIL=
POSTMARK_MESSAGE_STREAM=outbound

# Postmark inbound webhook auth (configured on the webhook URL in the Postmark dashboard)
POSTMARK_WEBHOOK_USERNAME=
POSTMARK_WEBHOOK_PASSWORD=

# Outscraper
OUTSCRAPER_API_KEY=

# Google Places API (for location picker) — public, used in browser; restrict by HTTP referrer
NEXT_PUBLIC_GOOGLE_PLACES_API_KEY=

# Public app URLs
NEXT_PUBLIC_APP_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
